{
  // ===================================================================
  // QUDOX - Configuracion de TypeScript (backend)
  //
  // MODULE SYSTEM: CommonJS (a proposito).
  //
  // Por que CommonJS y no ES Modules ("type": "module"):
  //   1. Explicabilidad. El enunciado pide poder explicar el codigo.
  //      CommonJS no exige escribir la extension ".js" en cada import
  //      relativo, que es la trampa clasica de ESM en Node.
  //   2. tsx corre el TypeScript directamente en desarrollo y los dos
  //      paths (tsx y tsc -> node dist/server.js) resuelven igual.
  //   3. Prisma 6 con el generador "prisma-client-js" esta pensado para
  //      ambos, pero el camino CommonJS es el mas estable de los dos.
  //   Con 5 endpoints no hay nada que ESM nos ahorre.
  //
  // MODULE RESOLUTION "node16": resuelve segun las reglas de Node 16+
  // (campo "exports" de cada paquete) y, como package.json NO declara
  // "type": "module", el emite sale en CommonJS y los imports relativos
  // sin ".js" siguen siendo validos. Es la resolucion mas cercana al
  // runtime real de Node sin pagar el costo de ESM.
  // ===================================================================
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "./src",
    "outDir": "./dist",

    // Modo estricto: requisito explicito del enunciado.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
