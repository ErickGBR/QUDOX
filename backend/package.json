{
  "name": "qudox-backend",
  "version": "1.0.0",
  "private": true,
  "description": "QUDOX - Prueba Tecnica Full Stack Developer. API de planillas (Express + TypeScript + Prisma + SQL Server).",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "4.22.3",
    "express-validator": "7.3.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "24.19.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
