# ============================================================
# QUDOX — Variables de entorno (EJEMPLO)
# ============================================================
# Este archivo es solo una plantilla con valores FALSOS.
# Los valores reales van en un archivo `.env` sin seguimiento
# (untracked), que nunca se sube al repositorio.
# Copia este archivo como punto de partida:
#   cp .env.example .env
# y reemplaza cada marcador por tu valor local.
# ============================================================

# --- Backend: conexión a SQL Server (consumida por Prisma) ---
# Formato Prisma para SQL Server: los parámetros van separados
# por punto y coma después del host y el puerto.
# `encrypt=true` es obligatorio en las versiones recientes del
# controlador: sin cifrado el cliente rechaza la conexión.
# En un entorno local/autofirmado hay que añadir además
# `trustServerCertificate=true`; sin ese parámetro la conexión
# falla con error de certificado, que es el fallo de
# configuración más común al levantar este proyecto.
# ATENCIÓN a la contraseña de SA: el contenedor de SQL Server
# se niega a arrancar con una clave débil. Debe cumplir la
# política de complejidad (mayúsculas, minúsculas, dígitos y
# al menos 8 caracteres). Usa un marcador obvio aquí y pon
# la clave real solo en tu `.env` local.
DATABASE_URL="sqlserver://TU_HOST:1433;database=TU_BASE_DE_DATOS;user=TU_USUARIO;password=TU_CONTRASEÑA_SEGURA_AQUI;encrypt=true;trustServerCertificate=true"

# --- Backend: puerto de escucha de Express ---
PORT=3000

# --- Frontend: URL base de la API (consumida por Vite) ---
# Valor local por defecto: el backend escucha en el puerto 3000.
VITE_API_URL="http://localhost:3000"

# --- SAP (simulado): sin credenciales ---
# El envío a SAP está SIMULADO (mock) según el enunciado:
# no existe conexión real con ningún sistema SAP y por tanto
# ninguna credencial SAP pertenece a este archivo.
