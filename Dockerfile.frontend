# ============================================================================
# QUDOX — Imagen del frontend (Vite 8 + React 19 -> nginx con proxy /api)
# Multi-stage: build (npm run build -> dist/) -> serve (nginx).
# El navegador llega a la API por MISMO ORIGEN (`/api/...` proxyeado al
# backend), así se evita CORS y Playwright no necesita saber el puerto interno.
# NOTA: `VITE_API_URL` se hornea en BUILD (Vite lo sustituye en tiempo de
# compilación). El valor `/` se normaliza a "" en `cliente.ts` y deja las
# llamadas como relativas (`/api/planillas/...` -> mismo origen -> nginx).
# ============================================================================

# --- Etapa 1: compilación del frontend
FROM node:22-bookworm-slim AS build
WORKDIR /app/frontend
# Solo manifiestos primero: capa de dependencias cacheable.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
# Resto del código (el .dockerignore excluye node_modules/dist).
COPY frontend/ ./
# ARG/ENV deliberado: `/` = mismo origen (nginx proxyea /api al backend).
ARG VITE_API_URL=/
ENV VITE_API_URL=${VITE_API_URL}
# `tsc -b && vite build` -> emite `dist/` (ver `frontend/package.json#build`).
RUN npm run build

# --- Etapa 2: servicio estático + reverse proxy (nginx)
FROM nginx:1.27-alpine AS runtime
# Configuración con el proxy `/api` -> backend (ver `docker/frontend-nginx.conf`).
COPY docker/frontend-nginx.conf /etc/nginx/conf.d/default.conf
# Artefacto compilado de la etapa `build`.
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
